# Copy to .env (same folder) and fill in. .env is git-ignored and never copied into the Docker image.
# Values already set in your shell override this file.

# Required on the Hub machine only for Claude models. Create the key in the Claude Console (see docs/models.md).
ANTHROPIC_API_KEY=

# For openai:<model> specs (--model / --agent-model): any OpenAI-compatible API (docs/models.md, "Other models").
# ASO_LLM_BASE_URL=http://avalon:11434/v1
# ASO_LLM_API_KEY=
# ASO_LLM_VISION=1

# Optional defaults for `aso start-hub` (flags override these).
# ASO_MODEL=claude-opus-5-5
# ASO_EFFORT=high
# ASO_TASK_BUDGET=5
# ASO_LLM_CONCURRENCY=4
# ASO_TEST_COMMAND=npm test
# ASO_ALLOW_DEPS=
# ASO_LOG_LEVEL=info
# 0 stops the Hub from updating outdated workers (they then need `aso update` by hand).
# ASO_AUTO_UPDATE=1
# GitHub token for pushing (Contents: read and write) and, with Pull requests: read and write,
# for opening a pull request per task that you merge on GitHub. 0 turns pull requests off.
# ASO_GIT_TOKEN=
# ASO_PULL_REQUESTS=1
